# Data layer: `firebase` (Firestore + Firebase Auth) or `local` (localStorage + mock sign-in).
VITE_DATA_BACKEND=firebase
# Comma-separated sign-in providers shown on the login screen: google, facebook, apple.
# Enable them in Firebase Auth first. Apple is implemented but hidden (needs an Apple Developer account).
VITE_AUTH_PROVIDERS=google,facebook

# Firebase web app config. These values identify the project and are public by design
# (they end up in the bundle anyway); access is protected by Auth, authorized domains and firestore.rules.
VITE_FIREBASE_API_KEY=AIzaSyC5ySr1VqOy8ZayB-tAjIZnmFT2xMqplZs
VITE_FIREBASE_AUTH_DOMAIN=pwa-todo-lists.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=pwa-todo-lists
VITE_FIREBASE_STORAGE_BUCKET=pwa-todo-lists.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=780416866457
VITE_FIREBASE_APP_ID=1:780416866457:web:2c9d58462e124b9c1c8008
